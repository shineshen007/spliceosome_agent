{
  "$defs": {
    "AssaySpec": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "title": "Matrix",
          "type": "string"
        },
        "metadata": {
          "title": "Metadata",
          "type": "string"
        },
        "scale": {
          "enum": [
            "counts",
            "log2_expression",
            "log2_abundance",
            "abundance"
          ],
          "title": "Scale",
          "type": "string"
        },
        "preprocessing": {
          "minLength": 1,
          "title": "Preprocessing",
          "type": "string"
        },
        "id_type": {
          "default": "UNKNOWN",
          "enum": [
            "SYMBOL",
            "ENSEMBL",
            "ENTREZ",
            "UNIPROT",
            "UNKNOWN"
          ],
          "title": "Id Type",
          "type": "string"
        },
        "cohort_id": {
          "default": "study",
          "title": "Cohort Id",
          "type": "string"
        },
        "columns": {
          "$ref": "#/$defs/MetadataColumns"
        },
        "mapping": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping"
        },
        "transform": {
          "default": "none",
          "enum": [
            "none",
            "log2"
          ],
          "title": "Transform",
          "type": "string"
        }
      },
      "required": [
        "matrix",
        "metadata",
        "scale",
        "preprocessing"
      ],
      "title": "AssaySpec",
      "type": "object"
    },
    "MetadataColumns": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "default": "sample_id",
          "title": "Sample Id",
          "type": "string"
        },
        "group": {
          "default": "group",
          "title": "Group",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "subject_id",
          "title": "Subject Id"
        }
      },
      "title": "MetadataColumns",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "analysis_mode": {
      "default": "candidate_screening",
      "enum": [
        "candidate_screening",
        "differential"
      ],
      "title": "Analysis Mode",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "species": {
      "default": "unknown",
      "minLength": 1,
      "title": "Species",
      "type": "string"
    },
    "design": {
      "enum": [
        "paired",
        "unpaired"
      ],
      "title": "Design",
      "type": "string"
    },
    "reference": {
      "title": "Reference",
      "type": "string"
    },
    "case": {
      "title": "Case",
      "type": "string"
    },
    "assays": {
      "additionalProperties": {
        "$ref": "#/$defs/AssaySpec"
      },
      "propertyNames": {
        "enum": [
          "rna",
          "protein"
        ]
      },
      "title": "Assays",
      "type": "object"
    },
    "candidates": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates"
    },
    "candidate_id_type": {
      "default": "SYMBOL",
      "enum": [
        "SYMBOL",
        "ENSEMBL",
        "ENTREZ",
        "UNIPROT"
      ],
      "title": "Candidate Id Type",
      "type": "string"
    },
    "covariates": {
      "additionalProperties": {
        "enum": [
          "continuous",
          "categorical"
        ],
        "type": "string"
      },
      "title": "Covariates",
      "type": "object"
    },
    "alpha": {
      "default": 0.05,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Alpha",
      "type": "number"
    },
    "confidence": {
      "default": 0.95,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "min_effect": {
      "default": 0,
      "minimum": 0,
      "title": "Min Effect",
      "type": "number"
    },
    "counts_min_total": {
      "default": 10,
      "minimum": 0,
      "title": "Counts Min Total",
      "type": "integer"
    },
    "min_units": {
      "default": 3,
      "minimum": 3,
      "title": "Min Units",
      "type": "integer"
    },
    "missing_policy": {
      "default": "exclude_feature",
      "enum": [
        "exclude_feature",
        "error"
      ],
      "title": "Missing Policy",
      "type": "string"
    },
    "seed": {
      "default": 2024,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "rscript": {
      "default": "Rscript",
      "title": "Rscript",
      "type": "string"
    },
    "r_library": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "R Library"
    },
    "font": {
      "default": "Arial",
      "title": "Font",
      "type": "string"
    },
    "allow_font_fallback": {
      "default": false,
      "title": "Allow Font Fallback",
      "type": "boolean"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "design",
    "reference",
    "case",
    "assays"
  ],
  "title": "StudySpec",
  "type": "object"
}
